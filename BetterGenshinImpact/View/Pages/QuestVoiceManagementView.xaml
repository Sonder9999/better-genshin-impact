<UserControl x:Class="BetterGenshinImpact.View.Pages.QuestVoiceManagementView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:BetterGenshinImpact.View.Pages"
 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <UserControl.Resources>
  <Style x:Key="ManagementSectionStyle" TargetType="Border">
   <Setter Property="Padding" Value="12" />
   <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
   <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="CornerRadius" Value="8" />
  </Style>
 </UserControl.Resources>
 <!-- 全局只允许一层垂直滚动：列表和详情分别自带独立滚动，顶栏永远可见。 -->
 <Grid IsEnabled="{Binding CanEditDraft, Mode=OneWay}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
  </Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" MinWidth="230" />
    <ColumnDefinition Width="*" MinWidth="230" />
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource ManagementSectionStyle}" Margin="0,0,6,0">
    <StackPanel>
     <ui:TextBlock Text="旅行者昵称与声线" FontWeight="SemiBold" Margin="0,0,0,6" />
     <ui:TextBox Text="{Binding PlayerNames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="每行一个游戏内昵称" PlaceholderText="游戏内昵称（一行一个）"
                 MinHeight="34" MaxHeight="56" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,0,0,6" />
     <local:QuestVoiceVoiceSelector ItemsSource="{Binding VoiceChoices, Mode=OneWay}"
                                    SelectedVoiceId="{Binding TravelerVoiceId, Mode=TwoWay}" />
    </StackPanel>
   </Border>
   <Border Grid.Column="1" Style="{StaticResource ManagementSectionStyle}" Margin="6,0,0,0">
    <StackPanel>
     <ui:TextBlock Text="默认 NPC 与旁白声线" FontWeight="SemiBold" Margin="0,0,0,6" />
     <ui:TextBlock Text="默认 NPC" Margin="0,0,0,4" />
     <local:QuestVoiceVoiceSelector ItemsSource="{Binding VoiceChoices, Mode=OneWay}"
                                    SelectedVoiceId="{Binding SelectedFallbackVoiceId, Mode=TwoWay}" Margin="0,0,0,6" />
     <ui:TextBlock Text="旁白" Margin="0,0,0,4" />
     <local:QuestVoiceVoiceSelector ItemsSource="{Binding VoiceChoices, Mode=OneWay}"
                                    SelectedVoiceId="{Binding SelectedNarratorVoiceId, Mode=TwoWay}"
                                    ToolTip="旁白识别尚未启用；此项设置会被保存" />
     <ui:TextBlock Text="找不到角色声线时" FontWeight="SemiBold" Margin="0,10,0,5" />
     <ComboBox ItemsSource="{Binding MissingPolicyChoices, Mode=OneWay}"
               DisplayMemberPath="Value" SelectedValuePath="Key"
               SelectedValue="{Binding MissingVoicePolicy, Mode=TwoWay}" />
     <ui:TextBlock Text="角色未绑定或资源不可用时的兜底规则；普通 NPC 使用默认 NPC 声线。"
                   TextWrapping="Wrap" Margin="0,5,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
   </Border>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="2*" MinWidth="200" />
    <ColumnDefinition Width="3*" MinWidth="280" />
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource ManagementSectionStyle}" Margin="0,0,10,0">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
     </Grid.RowDefinitions>
     <ui:TextBlock Grid.Row="0" Text="原神角色与识别名称" FontWeight="SemiBold" Margin="0,0,0,8" />
     <StackPanel Grid.Row="1" Margin="0,0,0,8">
         <ui:TextBox PlaceholderText="搜索角色、别名或纠错"
                     Text="{Binding SpeakerSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,6" />
         <CheckBox Content="仅显示当前剧情角色"
                   IsChecked="{Binding ShowCurrentStoryOnly, Mode=TwoWay}" Margin="0,0,0,6" />
         <ui:TextBlock Text="{Binding CurrentStorySummary, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,6"
                       ToolTip="{Binding CurrentStorySummary, Mode=OneWay}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
         <WrapPanel>
             <ui:Button Content="补齐剧情角色" Margin="0,0,6,4"
                        Command="{Binding AddMissingStorySpeakersCommand, Mode=OneWay}" />
             <ui:Button Content="按名称匹配声线" Margin="0,0,6,4"
                        Command="{Binding AutoBindCurrentStoryVoicesCommand, Mode=OneWay}" />
         </WrapPanel>
     </StackPanel>
     <ListBox Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" ItemsSource="{Binding FilteredSpeakers, Mode=OneWay}"
              SelectedItem="{Binding SelectedSpeaker, Mode=TwoWay}"
              DisplayMemberPath="DisplayName" ScrollViewer.VerticalScrollBarVisibility="Auto"
              VirtualizingStackPanel.IsVirtualizing="True"
              VirtualizingStackPanel.VirtualizationMode="Recycling">
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="7,9" />
       </Style>
      </ListBox.ItemContainerStyle>
     </ListBox>
    </Grid>
   </Border>
   <Border Grid.Column="1" Style="{StaticResource ManagementSectionStyle}">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
     </Grid.RowDefinitions>
     <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:TextBlock Grid.Column="0" Text="角色声线与 OCR 识别纠错" FontWeight="SemiBold" VerticalAlignment="Center" />
      <ui:Button Grid.Column="1" Content="添加" Command="{Binding AddSpeakerCommand, Mode=OneWay}"
                 Margin="8,0,0,0" />
      <ui:Button Grid.Column="2" Content="删除" Command="{Binding DeleteSpeakerCommand, Mode=OneWay}"
                 Margin="8,0,0,0" />
     </Grid>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
       <ui:TextBlock Text="专属声线（不指定时使用默认规则）" Margin="0,0,0,6" />
       <local:QuestVoiceVoiceSelector ItemsSource="{Binding VoiceChoices, Mode=OneWay}"
                                      SelectedVoiceId="{Binding SelectedSpeakerVoiceId, Mode=TwoWay}"
                                      Margin="0,0,0,10" />
       <StackPanel DataContext="{Binding SelectedSpeaker, Mode=OneWay}">
        <ui:TextBlock Text="正式名称（一行一个）" />
        <ui:TextBox Text="{Binding Names, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="100"
                    VerticalScrollBarVisibility="Auto" Margin="0,6,0,8" />
        <ui:TextBlock Text="识别别名（一行一个）" />
        <ui:TextBox Text="{Binding Aliases, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="100"
                    VerticalScrollBarVisibility="Auto" Margin="0,6,0,8" />
        <ui:TextBlock Text="OCR 易误识别名（一行一个）" />
        <ui:TextBox Text="{Binding Corrections, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="100"
                    VerticalScrollBarVisibility="Auto" Margin="0,6,0,8" />
        <ui:TextBlock Text="角色 ID（一般不需要修改）" />
        <ui:TextBox Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,6,0,8" />
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
