<UserControl x:Class="BetterGenshinImpact.View.Pages.QuestVoiceSettings.QuestVoiceStoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:BetterGenshinImpact.View.Pages.QuestVoiceSettings"
             xmlns:pages="clr-namespace:BetterGenshinImpact.View.Pages"
             Loaded="OnLoaded"
             HorizontalContentAlignment="Stretch"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <!-- 不替换 BetterGI 的按钮、输入、选择器主题，只统一面板边界。 -->
        <Style x:Key="QuestStorySection" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="QuestStoryEllipsis" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <TabControl BorderThickness="0" Margin="0,4,0,0">
        <!-- 全局剧情仅在这里选择；右栏配置当前出场角色。台词节点浏览独立于此页。 -->
        <TabItem Header="1. 剧情选择与声线">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" MinWidth="255" />
                    <ColumnDefinition Width="1.1*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- 与 QuestVoice QuestSelectionPanel 一致的系列/章节/任务分级浏览，使用 BetterGI 主题。 -->
                <Border Grid.Column="0" Style="{StaticResource QuestStorySection}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,9">
                            <ui:TextBlock FontWeight="SemiBold" Text="选择剧情与任务" FontSize="15" />
                            <ui:TextBlock Text="使用 + 展开系列，点击章节加载中日剧情；加载后可继续展开主任务和子任务。"
                                          TextWrapping="Wrap" Margin="0,5,0,0"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" PlaceholderText="搜索系列、章节、任务名称或 ID"
                                        Text="{Binding ChapterSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsEditable, Mode=OneWay}" />
                            <ui:Button Grid.Column="1" Content="刷新目录" Margin="8,0,0,0"
                                       Command="{Binding RefreshCatalogCommand, Mode=OneWay}"
                                       IsEnabled="{Binding IsEditable, Mode=OneWay}" />
                        </Grid>
                        <ui:TextBlock Grid.Row="2" Text="{Binding CatalogStatus, Mode=OneWay}"
                                      TextTrimming="CharacterEllipsis" ToolTip="{Binding CatalogStatus, Mode=OneWay}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                        <ListBox Grid.Row="3" ItemsSource="{Binding CatalogRows, Mode=OneWay}"
                                 SelectedItem="{Binding SelectedCatalogRow, Mode=TwoWay}"
                                 IsEnabled="{Binding IsEditable, Mode=OneWay}"
                                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="2,3" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="{Binding Indent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="{Binding ExpandMarker}"
                                                IsEnabled="{Binding CanExpand}" Width="26" MinHeight="24" Padding="0"
                                                Command="{Binding DataContext.ToggleCatalogRowCommand, RelativeSource={RelativeSource AncestorType={x:Type local:QuestVoiceStoryPanel}}, Mode=OneWay}"
                                                CommandParameter="{Binding}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <DockPanel LastChildFill="True">
                                                <ui:TextBlock DockPanel.Dock="Left" Text="{Binding DisplayKind, Mode=OneWay}"
                                                              Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                              Margin="0,0,7,0" FontWeight="SemiBold" />
                                                <ui:TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"
                                                              TextTrimming="CharacterEllipsis" ToolTip="{Binding Title, Mode=OneWay}" />
                                            </DockPanel>
                                            <ui:TextBlock Text="{Binding Detail, Mode=OneWay}" Margin="0,2,0,0"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                          TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="4" Margin="0,8,0,0">
                            <ui:TextBlock Text="{Binding ChapterStatus, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                          ToolTip="{Binding ChapterStatus, Mode=OneWay}" />
                            <ui:TextBlock Text="{Binding TaskFilterStatus, Mode=OneWay}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 右侧只管理当前出场角色的声线与配音范围，不再复制台词列表或节点聚焦。 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource QuestStorySection}" Margin="0,0,0,10">
                        <StackPanel>
                            <ui:TextBlock Text="当前剧情与双语原文" FontSize="15" FontWeight="SemiBold" />
                            <ui:TextBlock Text="{Binding ActiveSelectionLabel, Mode=OneWay}"
                                          Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                          TextTrimming="CharacterEllipsis" Margin="0,6,0,8" />
                            <WrapPanel IsEnabled="{Binding IsEditable, Mode=OneWay}">
                                <StackPanel Width="154" Margin="0,0,10,8">
                                    <ui:TextBlock Text="目标配音语言" Margin="0,0,0,4" />
                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Config.SpeechLanguage, Mode=TwoWay}">
                                        <ComboBoxItem Tag="jpn" Content="日语（JP）" />
                                        <ComboBoxItem Tag="chs" Content="中文（CHS）" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="170" Margin="0,0,10,8">
                                    <ui:TextBlock Text="旅行者游戏昵称" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding Config.TravelerNickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="未指定" />
                                </StackPanel>
                                <ui:ToggleSwitch Content="荧" Margin="0,18,0,0"
                                                 IsChecked="{Binding Config.FemaleTraveler, Mode=TwoWay}" />
                            </WrapPanel>
                            <ui:ToggleSwitch Content="启用中日原文精确路由（实时 P0）"
                                             IsEnabled="{Binding IsEditable, Mode=OneWay}"
                                             IsChecked="{Binding Config.ScriptLanguageRoutingEnabled, Mode=TwoWay}" />
                            <ui:TextBlock Text="仅匹配当前章节中唯一、可靠的双语节点；不翻译或猜测短句，台词浏览在第二个标签。"
                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource QuestStorySection}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock Grid.Row="0" Text="当前剧情角色与声线绑定" FontSize="15" FontWeight="SemiBold" />
                            <ui:TextBlock Grid.Row="1" Text="{Binding Management.CurrentStorySummary, Mode=OneWay}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,8" />
                            <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                                <ui:Button Content="补齐角色档案" Margin="0,0,8,4"
                                           Command="{Binding Management.AddMissingStorySpeakersCommand, Mode=OneWay}" />
                                <ui:Button Content="精确匹配声线" Margin="0,0,8,4"
                                           Command="{Binding Management.AutoBindCurrentStoryVoicesCommand, Mode=OneWay}" />
                            </WrapPanel>
                            <ListBox Grid.Row="3" ItemsSource="{Binding Management.CurrentStorySpeakers, Mode=OneWay}"
                                     Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="Padding" Value="5,6" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBlock Grid.Column="0" Text="{Binding DisplayName, Mode=OneWay}"
                                                          VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                          ToolTip="{Binding DisplayName, Mode=OneWay}" />
                                            <pages:QuestVoiceVoiceSelector Grid.Column="1"
                                                ItemsSource="{Binding DataContext.Management.VoiceChoices, RelativeSource={RelativeSource AncestorType={x:Type local:QuestVoiceStoryPanel}}, Mode=OneWay}"
                                                SelectedVoiceId="{Binding VoiceId, Mode=TwoWay}"
                                                IsEnabled="{Binding DataContext.Management.CanEditDraft, RelativeSource={RelativeSource AncestorType={x:Type local:QuestVoiceStoryPanel}}, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource QuestStorySection}">
                        <StackPanel>
                            <ui:TextBlock Text="{Binding PreSynthesisStatus, Mode=OneWay}"
                                          TextTrimming="CharacterEllipsis" ToolTip="{Binding PreSynthesisStatus, Mode=OneWay}" />
                            <ProgressBar Height="5" Minimum="0" Maximum="100" Margin="0,8,0,8"
                                         Value="{Binding ProgressPercent, Mode=OneWay}" />
                            <WrapPanel>
                                <ui:Button Content="预合成当前范围" Appearance="Primary" Margin="0,0,8,4"
                                           Command="{Binding StartPreSynthesisCommand, Mode=OneWay}"
                                           IsEnabled="{Binding IsEditable, Mode=OneWay}" />
                                <ui:Button Content="暂停" Margin="0,0,8,4"
                                           Command="{Binding PausePreSynthesisCommand, Mode=OneWay}"
                                           IsEnabled="{Binding IsGenerating, Mode=OneWay}" />
                                <ui:Button Content="恢复" Margin="0,0,8,4"
                                           Command="{Binding ResumePreSynthesisCommand, Mode=OneWay}"
                                           IsEnabled="{Binding IsGenerating, Mode=OneWay}" />
                                <ui:Button Content="停止" Margin="0,0,8,4"
                                           Command="{Binding StopPreSynthesisCommand, Mode=OneWay}"
                                           IsEnabled="{Binding IsGenerating, Mode=OneWay}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
        <!-- 台词浏览与前后节点上下文共用同一全局选择，避免两个目录状态。 -->
        <TabItem Header="台词浏览与节点聚焦">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="210" />
                    <ColumnDefinition Width="4*" MinWidth="300" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource QuestStorySection}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" Text="{Binding ChapterStatus, Mode=OneWay}" TextWrapping="Wrap"
                                      Margin="0,0,0,8" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding VisibleLines, Mode=OneWay}"
                                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                 SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <ui:TextBlock Text="{Binding Speaker, Mode=OneWay}" FontWeight="SemiBold" />
                                        <ui:TextBlock Text="{Binding Chinese, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource QuestStorySection}" Margin="0,0,0,10">
                        <StackPanel>
                            <ui:TextBlock FontWeight="SemiBold" Text="当前节点与前后关联" Margin="0,0,0,6" />
                            <ui:TextBlock Text="{Binding FocusContext, Mode=OneWay}" TextWrapping="Wrap"
                                          MaxHeight="88" ToolTip="{Binding FocusContext, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource QuestStorySection}" Margin="0,0,0,10">
                        <DockPanel>
                            <ui:TextBlock DockPanel.Dock="Top" Text="CHS · 中文原文" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ui:TextBlock Text="{Binding SelectedLine.Chinese, Mode=OneWay}" TextWrapping="Wrap"
                                              FontSize="15" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource QuestStorySection}" Margin="0,0,0,10">
                        <DockPanel>
                            <ui:TextBlock DockPanel.Dock="Top" Text="JP · 日语原文" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ui:TextBlock Text="{Binding SelectedLine.Japanese, Mode=OneWay}" TextWrapping="Wrap"
                                              FontSize="15" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="3" Style="{StaticResource QuestStorySection}">
                        <StackPanel>
                            <ui:TextBlock Text="{Binding SelectedLine.State, Mode=OneWay}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          TextTrimming="CharacterEllipsis"
                                          ToolTip="{Binding SelectedLine.State, Mode=OneWay}" Margin="0,0,0,6" />
                            <WrapPanel>
                                <ui:Button Content="播放本地 WAV" Command="{Binding PlayCachedWAVCommand, Mode=OneWay}"
                                           Margin="0,0,8,4" />
                                <ui:Button Content="停止试听" Command="{Binding StopCachedWAVCommand, Mode=OneWay}"
                                           Margin="0,0,8,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
